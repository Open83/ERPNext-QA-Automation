# ERPNext QA Automation Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env - it should be in .gitignore

# ERPNext Instance URL (required for authentication and tests)
ERP_BASE_URL=https://your-erpnext-instance.m.frappe.cloud

# Authentication Credentials (required for auth.setup.js)
ERP_USER=your-email@example.com
ERP_PASSWORD=your-password

# Note: After first successful authentication, tests reuse stored session
# from playwright/.auth/user.json (excluded from git)
