# ERPNext QA Automation Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env - it should be in .gitignore

# ERPNext Instance URL
BASE_URL=https://your-erpnext-instance.m.frappe.cloud

# Authentication (if needed)
# FRAPPE_USERNAME=your-email@example.com
# FRAPPE_PASSWORD=your-password

# (Credentials are managed through playwright .auth/ folder, not env vars)
